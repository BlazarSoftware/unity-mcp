/* MCP For Unity - Common Styles */
/* Theme: Professional / Cranky Magician */

/* --- Fonts & Typography --- */
.custom-font {
    -unity-font: resource("Fonts/Montserrat-Regular");
}

.custom-font-bold {
    -unity-font: resource("Fonts/Montserrat-Bold");
    -unity-font-style: bold;
}

Label {
    -unity-font: resource("Fonts/Montserrat-Regular");
    color: #E0E0E0; /* Slightly brighter text */
}

/* --- Root Layout --- */
.root-background {
    flex-grow: 1;
    background-color: #1e1e1e;
    overflow: hidden;
}

.root-layout {
    flex-grow: 1;
    padding: 16px;
    background-color: #2d2d2d;
    flex-direction: column;
}

#root-container {
    padding: 0;
    flex-grow: 1;
    overflow: hidden;
    background-color: transparent;
}

/* --- Header --- */
.header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: #4a4a4a;
    padding-bottom: 16px;
}

.header-logo {
    width: 64px;
    height: 64px;
    margin-right: 16px;
    background-image: resource("Images/Logo");
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.header-title {
    font-size: 28px;
    color: #E0E0E0;
    -unity-font-style: bold;
    -unity-font: resource("Fonts/Montserrat-Bold");
    padding: 0;
    background-color: transparent;
    margin-bottom: 0;
}

/* Legacy Title Class Support (Hidden) */
.title {
    display: none;
}

/* --- Tabs --- */
.tabs-container {
    margin-bottom: 16px;
}

.tab-toolbar {
    background-color: transparent;
    border-width: 0;
    margin-bottom: 0;
}

.tab-toggle {
    background-color: #383838;
    color: #B0B0B0;
    border-radius: 4px;
    margin-right: 4px;
    border-width: 1px;
    border-color: #4a4a4a;
    -unity-font: resource("Fonts/Montserrat-Regular");
    transition-duration: 0.15s;
    height: 36px;
    font-size: 14px;
}

.tab-toggle:checked {
    background-color: #4a4a4a;
    color: #FFFFFF;
    border-color: #6a6a6a;
    -unity-font-style: bold;
}

.tab-toggle:hover {
    background-color: #424242;
}

.tab-toolbar .unity-toolbar-button {
    flex-grow: 1;
}

/* --- Content Panels --- */
.content-container {
    flex-grow: 1;
    overflow: hidden;
}

.panel-scroll {
    flex-grow: 1;
    margin-top: 4px;
}

.hidden {
    display: none;
}

.section-stack {
    flex-direction: column;
}

/* --- Sections --- */
.section {
    margin-bottom: 16px;
    padding: 16px;
    background-color: #383838;
    border-radius: 4px;
    border-width: 1px;
    border-color: #4a4a4a;
}

.section-title {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-font: resource("Fonts/Montserrat-Bold");
    margin-bottom: 12px;
    color: #E0E0E0;
    border-bottom-width: 1px;
    border-bottom-color: #4a4a4a;
    padding-bottom: 8px;
}

.section-content {
    padding: 4px;
}

/* --- Settings Rows --- */
.setting-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    min-height: 28px; /* Increased min-height */
    flex-shrink: 1;
    min-width: 0;
}

.setting-column {
    flex-direction: column;
    margin-bottom: 8px;
    flex-shrink: 1;
    min-width: 0;
}

.setting-label {
    min-width: 160px; /* Increased width for larger font */
    flex-shrink: 0;
    -unity-text-align: middle-left;
    color: #E0E0E0;
    font-size: 18px; /* Increased from 14px */
}

.setting-value {
    -unity-text-align: middle-right;
    color: #CCCCCC;
    -unity-font-style: italic;
    font-size: 16px; /* New font size */
}

.setting-toggle {
    margin-left: auto;
}

.setting-dropdown {
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 4px;
    max-width: 100%;
}

.setting-dropdown-inline {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 150px;
    flex-basis: 200px;
}

/* --- Inputs --- */
.unity-text-field__input {
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: #E0E0E0;
    -unity-font: resource("Fonts/Montserrat-Regular");
    font-size: 14px;
}

.unity-text-field__input:focus {
    border-color: #64B5F6;
}

.unity-base-popup-field__input {
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: #E0E0E0;
    font-size: 16px; /* Increased from default */
}

/* --- Validation --- */
.validation-description {
    margin-top: 4px;
    padding: 8px;
    background-color: #2d2d2d;
    border-radius: 4px;
    font-size: 13px;
    white-space: normal;
    color: #A0A0A0;
    border-width: 1px;
    border-color: #4a4a4a;
}

/* --- Fields --- */
.port-field {
    width: 100px;
    margin-left: auto;
}

.url-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 200px;
    flex-basis: 250px;
}

.port-field > .unity-text-field__input {
    -unity-text-align: middle-center;
}

/* --- Status --- */
.status-container {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.status-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    margin-right: 8px;
    background-color: rgba(150, 150, 150, 1);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.3);
}

.status-dot.connected {
    background-color: #4CAF50;
    border-color: rgba(76, 175, 80, 0.5);
}
.status-dot.disconnected { background-color: #f44336; }
.status-dot.configured { background-color: #4CAF50; }
.status-dot.not-configured { background-color: #f44336; }
.status-dot.warning { background-color: #ff9800; }
.status-dot.unknown { background-color: rgba(150, 150, 150, 1); }
.status-dot.healthy {
    background-color: #4CAF50;
    border-color: rgba(76, 175, 80, 0.5);
}

.status-text {
    -unity-text-align: middle-left;
    color: #E0E0E0;
    font-size: 16px; /* Increased from 14px */
}

.status-indicator-small {
    width: 12px; /* Increased from 10px */
    height: 12px;
    border-radius: 6px;
    margin-left: 8px;
    background-color: rgba(150, 150, 150, 1);
}

.status-indicator-small.valid { background-color: rgba(0, 200, 100, 1); }
.status-indicator-small.invalid { background-color: rgba(200, 50, 50, 1); }

/* --- Buttons --- */
.action-button {
    min-width: 100px;
    height: 36px;
    margin-left: 8px;
    background-color: #1565C0;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    -unity-font-style: bold;
    -unity-font: resource("Fonts/Montserrat-Bold");
    color: white;
    font-size: 14px;
    transition-duration: 0.15s;
}

.action-button:hover {
    background-color: #1976D2;
    border-color: #64B5F6;
    scale: 1.05;
}

.action-button:active {
    background-color: #0D47A1;
    scale: 0.98;
}

.start-server-button {
    margin-left: 0px;
}

.action-button.server-running {
    background-color: rgba(160, 30, 30, 0.9);
}

.action-button.server-running:hover {
    background-color: rgba(200, 40, 40, 1);
}

.secondary-button {
    width: 100%;
    height: 32px; /* Increased from 28px */
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    color: #E0E0E0;
    border-width: 0;
    font-size: 14px; /* New font size */
}

.secondary-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

/* --- Manual Config --- */
.manual-config-content {
    padding: 8px;
    margin-top: 8px;
    background-color: #2d2d2d;
    border-radius: 4px;
    flex-shrink: 1;
    min-width: 0;
}

.config-label {
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 4px;
    color: #C0C0C0;
}

.path-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    flex-shrink: 1;
    min-width: 0;
}

.config-path-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 4px;
    min-width: 0;
    max-width: 100%;
}

.icon-button {
    min-width: 50px;
    height: 28px; /* Increased from 24px */
    margin-left: 4px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 0;
    border-radius: 4px;
    color: #E0E0E0;
}

.icon-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.config-json-row {
    flex-direction: row;
    margin-bottom: 8px;
    flex-shrink: 1;
    min-width: 0;
}

.config-json-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 80px; /* Increased from 64px */
    margin-right: 4px;
    min-width: 0;
    max-width: 100%;
}

.config-json-field > .unity-text-field__input {
    font-size: 14px; /* Increased from 11px */
    -unity-font-style: normal;
    white-space: normal;
    overflow: hidden;
    /* Consolas or System Font for code */
    -unity-font: initial; 
}

.icon-button-vertical {
    min-width: 50px;
    height: 36px; /* Increased from 30px */
    align-self: flex-start;
}

.installation-steps {
    padding: 8px;
    background-color: #2d2d2d;
    border-radius: 4px;
    font-size: 13px;
    white-space: normal;
    margin-top: 4px;
    color: #A0A0A0;
}

/* --- Tools Section --- */
.tool-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
    margin-bottom: 8px;
}

.tool-action-button {
    flex-grow: 1;
    min-width: 0;
    height: 32px; /* Increased from 30px */
    margin-bottom: 4px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 0;
    border-radius: 4px;
    color: #E0E0E0;
    font-size: 14px; /* Increased from 12px */
}

.tool-action-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.tool-category-container {
    flex-direction: column;
    margin-top: 8px;
}

.tool-item {
    flex-direction: column;
    padding: 8px;
    margin-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.tool-item-header {
    flex-direction: row;
    align-items: center;
}

.tool-item-toggle {
    flex-shrink: 0;
    min-width: 0;
}

/* Toggle label font size */
.tool-item-toggle > Label {
    font-size: 16px;
}

.tool-tags {
    flex-direction: row;
    flex-wrap: wrap;
    margin-left: auto;
    padding-left: 8px;
}

.tool-tag {
    font-size: 11px;
    padding: 2px 6px;
    margin-left: 4px;
    margin-top: 2px;
    background-color: #4a4a4a;
    border-radius: 3px;
    color: #B0B0B0;
}

.tool-item-description,
.tool-parameters {
    font-size: 16px; /* Increased from 12px */
    color: #B0BEC5;
    white-space: normal;
    margin-top: 4px;
}

.tool-description-warning {
    color: #FF6060;
    -unity-font-style: bold;
    text-shadow: 1px 1px 1px black;
}

.tool-parameters {
    -unity-font-style: italic;
    font-size: 14px; /* Slightly smaller than description */
}

/* --- Advanced Settings --- */
.advanced-settings-foldout {
    margin-top: 16px;
}

.advanced-settings-foldout > .unity-foldout__toggle {
    -unity-font-style: bold;
    font-size: 15px; /* Increased from 13px */
    color: #E0E0E0;
}

.advanced-settings-content {
    padding: 8px;
    margin-top: 8px;
    background-color: #2d2d2d;
    border-radius: 4px;
    flex-shrink: 1;
    min-width: 0;
}

.advanced-label {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    color: #C0C0C0;
    white-space: normal;
    flex-shrink: 1;
    min-width: 0;
}

.override-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 4px;
}

.override-label {
    font-size: 14px; /* Increased from 12px */
    -unity-font-style: bold;
    min-width: 140px; /* Increased width */
    white-space: normal;
    flex-shrink: 1;
    color: #E0E0E0;
}

.help-text {
    font-size: 12px; /* Increased from 11px */
    color: #90A4AE;
    white-space: normal;
    flex-shrink: 1;
    min-width: 0;
    margin-bottom: 4px;
}

.path-override-controls {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    flex-shrink: 1;
    min-width: 0;
}

.override-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 4px;
    min-width: 0;
    max-width: 100%;
}

.setting-label-small {
    font-size: 14px; /* Increased from 12px */
    min-width: 140px;
    -unity-text-align: middle-left;
    color: #E0E0E0;
}

.path-display-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 4px;
    min-width: 0;
    max-width: 100%;
}

/* --- Theme Overrides --- */
.unity-theme-light .title {
    background-color: rgba(0, 0, 0, 0.05);
}
