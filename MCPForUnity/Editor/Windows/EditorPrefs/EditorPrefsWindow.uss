/* EditorPrefs Window Styles - Professional Theme */

/* Header customization for prefs window */
.prefs-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.prefs-logo {
    width: 48px;
    height: 48px;
}

.header-text-container {
    flex-direction: column;
}

.prefs-title {
    font-size: 24px;
    margin-bottom: 2px;
}

.prefs-description {
    color: #90A4AE;
    font-size: 12px;
    margin-left: 2px;
}

/* Scroll container */
.prefs-scroll {
    flex-grow: 1;
}

/* Controls section */
.controls {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 4px;
}

.add-section {
    margin-bottom: 16px;
}

.primary-button {
    -unity-text-align: middle-center;
    background-color: #1565C0;
    color: white;
    border-radius: 4px;
    padding: 8px 16px;
    -unity-font-style: bold;
}

.primary-button:hover {
    background-color: #1976D2;
}

/* Add New Row */
.add-new-row {
    background-color: #383838;
    border-width: 1px;
    border-color: #4a4a4a;
    border-radius: 4px;
    padding: 16px;
    margin-bottom: 16px;
}

.add-row-content {
    flex-direction: row;
    align-items: flex-end;
    flex-wrap: wrap;
}

.add-row-content .key-field {
    flex: 1;
    min-width: 200px;
    margin-right: 12px;
}

.add-row-content .value-field {
    flex: 1;
    min-width: 150px;
    margin-right: 12px;
}

.add-row-content .type-dropdown {
    width: 100px;
    margin-right: 12px;
}

.add-buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 8px;
}

.add-buttons .cancel-button {
    margin-left: 8px;
}

.save-button {
    background-color: #4CAF50;
    color: white;
    min-width: 60px;
    border-radius: 4px;
    border-width: 0;
    -unity-font-style: bold;
}

.save-button:hover {
    background-color: #45a049;
}

.cancel-button {
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    min-width: 60px;
    border-radius: 4px;
    color: #E0E0E0;
}

.cancel-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

/* Pref Items */
.prefs-container {
    flex-direction: column;
}

.pref-item {
    margin-bottom: 0;
    background-color: #383838;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: #4a4a4a;
    border-radius: 0;
    padding: 10px 8px;
}

.pref-item:hover {
    background-color: #424242;
}

.pref-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: nowrap;
}

.pref-row .key-section {
    flex-shrink: 0;
    width: 200px;
    margin-right: 12px;
}

.pref-row .value-field {
    flex: 1;
    min-width: 150px;
    margin-right: 12px;
}

.pref-row .type-dropdown {
    width: 100px;
    margin-right: 12px;
}

.pref-row .action-buttons {
    flex-direction: row;
    width: 32px;
    justify-content: flex-start;
}

.key-section {
    flex-direction: column;
    min-width: 200px;
}

.key-label {
    -unity-font-style: bold;
    color: #E0E0E0;
    white-space: normal;
    font-size: 13px;
}

.value-field {
    flex: 1;
    min-width: 150px;
}

.type-dropdown {
    width: 100px;
}

.action-buttons {
    flex-direction: row;
}

.action-buttons .save-button {
    background-color: #4CAF50;
    color: white;
    min-width: 32px;
    height: 28px;
    padding: 0;
    font-size: 14px;
    -unity-font-style: bold;
    border-width: 0;
    border-radius: 4px;
}

.action-buttons .save-button:hover {
    background-color: #45a049;
}
