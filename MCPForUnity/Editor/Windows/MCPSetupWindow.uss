/* MCP Setup Window Styles */

/* Setup-specific header adjustments */
.setup-header {
    margin-bottom: 16px;
}

.setup-header .header-title {
    font-size: 28px;
}

/* Setup scroll container */
.setup-scroll {
    flex-grow: 1;
}

/* Root container padding override */
#root-container {
    padding: 0;
}

/* Dependency list */
#dependency-list {
    margin-top: 8px;
}

/* Dependency item container */
.dependency-item {
    margin-bottom: 12px;
}

/* Dependency row (name + version + indicator) */
.dependency-row {
    flex-direction: row;
    align-items: center;
}

/* Dependency name label */
.dependency-name {
    -unity-font-style: bold;
    min-width: 150px;
    font-size: 14px;
}

/* Status indicator positioning */
.dependency-row .status-indicator-small {
    margin-left: 8px;
}

/* Dependency details text */
.dependency-details {
    margin-left: 0px;
    margin-top: 4px;
}

/* Status message container */
#status-message-container {
    margin-top: 16px;
}

/* Status message text */
#status-message {
    white-space: normal;
}

/* Installation section */
#installation-section {
    margin-top: 16px;
    padding: 12px;
    background-color: #2d2d2d;
    border-radius: 4px;
    border-width: 1px;
    border-color: #4a4a4a;
    display: none;
}

.installation-container {
    flex-shrink: 1;
    min-width: 0;
}

/* Installation section title */
.installation-title {
    -unity-font-style: bold;
    margin-bottom: 8px;
    color: #C0C0C0;
    font-size: 13px;
}

/* Installation instructions text */
#installation-instructions {
    white-space: normal;
    margin-bottom: 4px;
}

.install-links-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.install-link-button {
    flex-grow: 1;
    min-width: 180px;
    margin-top: 0;
    margin-right: 8px;
}

/* Button container at bottom */
.button-container {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-top: 16px;
    padding-top: 16px;
    border-top-width: 1px;
    border-top-color: #4a4a4a;
}

/* Button sizing */
.setup-button {
    min-width: 96px;
}

/* Description text spacing */
.description-text {
    margin-bottom: 12px;
}
